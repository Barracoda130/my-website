SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-backend.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.up.railway.app,https://your-backend.up.railway.app
DATABASE_URL=postgresql://user:password@host:port/database

# Optional throttle overrides
DRF_ANON_THROTTLE_RATE=100/hour
DRF_USER_THROTTLE_RATE=1000/hour
DRF_LOGIN_THROTTLE_RATE=5/minute
DRF_TOKEN_REFRESH_THROTTLE_RATE=30/minute
DRF_REGISTER_THROTTLE_RATE=20/hour
DRF_INVITE_VALIDATE_THROTTLE_RATE=30/hour